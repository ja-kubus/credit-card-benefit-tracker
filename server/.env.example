# ============================================================================
# Teller Backend — environment configuration
# Copy to .env and fill in real values.  .env is gitignored — NEVER commit it.
# ============================================================================

# --- Server ---
# Port the HTTP server listens on.
PORT=8080
# Node environment: "development" | "production"
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed origins. For a native iOS app there is often
# no browser Origin header, but keep this locked for any web/dev tooling.
# Example: https://app.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Session (our own JWTs issued to the app) ---
# Strong random secret used to sign our session JWTs (HS256).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Encryption master key (AES-256-GCM at rest for Teller access tokens) ---
# 32 raw bytes, base64-encoded. Generate with: openssl rand -base64 32
# If this leaks, all stored tokens are compromised — rotate immediately.
MASTER_KEY=

# --- Sign in with Apple ---
# The audience your Apple identity tokens are issued for: your app's bundle id
# (native app) or Services ID (web). Found in your Apple Developer account.
APPLE_CLIENT_ID=com.yourcompany.CreditCardBenefitTracker

# --- Teller mTLS client certificate + private key ---
# Provide EITHER the file paths (recommended) OR the inline PEM contents.
# The cert/key come from your Teller dashboard's teller.zip
# (certificate.pem / private_key.pem). Without this cert, an access token
# is useless — that is the point of mTLS.
#
# Option A — file paths:
TELLER_CERT_PATH=./certs/certificate.pem
TELLER_KEY_PATH=./certs/private_key.pem
#
# Option B — inline PEM (use \n-free multi-line, or a single line with real
# newlines preserved by your secret manager). Leave the *_PATH vars empty if
# you use these.
# TELLER_CERT_PEM=
# TELLER_KEY_PEM=

# Teller API base URL. Sandbox and production share this host; the environment
# is determined by the access tokens you use.
TELLER_API_BASE=https://api.teller.io

# --- Datastore ---
# Path to the SQLite file. Contains ENCRYPTED tokens only. Keep off version
# control and back up securely.
DATABASE_PATH=./data/app.sqlite
