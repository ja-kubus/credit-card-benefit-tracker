# ============================================================================
# Linking Backend — environment configuration
# Copy to .env and fill in real values.  .env is gitignored — NEVER commit it.
# ============================================================================

# --- Server ---
# Port the HTTP server listens on.
PORT=8080
# Node environment: "development" | "production"
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed origins. For a native iOS app there is often
# no browser Origin header, but keep this locked for any web/dev tooling.
# Example: https://app.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Session (our own JWTs issued to the app) ---
# Strong random secret used to sign our session JWTs (HS256).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Sign in with Apple ---
# The audience your Apple identity tokens are issued for: your app's bundle id
# (native app) or Services ID (web). Found in your Apple Developer account.
APPLE_CLIENT_ID=com.yourcompany.CreditCardBenefitTracker

# --- Stripe (Financial Connections) ---
# Your Stripe SECRET key. Starts with sk_test_ (test mode) or sk_live_ (live).
# This is the ONLY provider secret this service holds. If it leaks, rotate it
# in the Stripe Dashboard immediately. NEVER use a publishable (pk_) key here.
STRIPE_SECRET_KEY=

# Optional: signing secret for the Stripe webhook endpoint (whsec_...). Only
# needed if you enable the financial_connections.account.refreshed_transactions
# webhook for incremental sync. Leave blank to disable webhook handling.
STRIPE_WEBHOOK_SECRET=

# NOTE: this service is STATELESS — there is no database. The app-user ->
# Stripe-customer mapping is stored in Stripe (customer metadata), so there is
# nothing to persist locally and no DATABASE_PATH.
